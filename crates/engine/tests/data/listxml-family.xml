    <rom name="snd.u2" size="8" crc="50a00002" sha1="50a0000000000000000000000000000000000002" region="audio" offset="0"/>
    <device_ref name="z80"/>
  </machine>
  <machine name="z80" sourcefile="devices/cpu/z80/z80.cpp" isdevice="yes" runnable="no">
    <description>Zilog Z80</description>
  </machine>
  <machine name="blaster" sourcefile="acme/blaster.cpp" romof="arcbios" sampleof="blaster">
