    <rom name="gfx.u4" size="32" crc="6f000004" sha1="6f00000000000000000000000000000000000004" status="baddump" region="gfx" offset="0"/>
    <rom name="pal.u5" size="260" status="nodump" region="plds" offset="0"/>
    <rom name="snd.u6" size="8" crc="5d000006" sha1="5d00000000000000000000000000000000000006" optional="yes" region="audio" offset="0"/>
    <disk name="blaster" sha1="d15c000000000000000000000000000000000002" region="ide:0:hdd" index="0" writable="no"/>
    <device_ref name="acmesnd"/>
    <device_ref name="z80"/>
    <sample name="laser"/>
    <sample name="boom"/>
    <chip type="cpu" tag="maincpu" name="Zilog Z80" clock="4000000"/>
    <display tag="screen" type="raster" rotate="0" width="320" height="224" refresh="60.000000"/>
