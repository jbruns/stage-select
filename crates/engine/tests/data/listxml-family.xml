    <driver status="good" emulation="good" savestate="supported"/>
    <feature type="sound" status="imperfect"/>
    <feature type="protection" overall="unemulated"/>
    <softwarelist tag="cart" name="blaster_cart" status="original"/>
  </machine>
  <machine name="blasterj" sourcefile="acme/blaster.cpp" cloneof="blaster" romof="blaster" sampleof="blaster">
    <description>Blaster (Japan)</description>
    <year>1995</year>
    <manufacturer>Acme</manufacturer>
    <rom name="bios.u1" merge="bios.u1" size="16" crc="b1050001" sha1="b105000000000000000000000000000000000001" region="bios" offset="0"/>
