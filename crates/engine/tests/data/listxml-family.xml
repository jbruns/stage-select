<?xml version="1.0"?>
<!-- A synthetic MAME ListXML: a BIOS, a device chain to a ROM-less device, a parent and clone sharing ROMs and a Disk
     by merge=, a non-clone sharing a Disk with its BIOS, and nodump, baddump and optional ROMs. Its names and
     checksums are invented. -->
<!DOCTYPE mame [
<!ELEMENT mame (machine+)>
]>
<mame build="0.289 (mame0289)" debug="no" mameconfig="10">
  <machine name="arcbios" sourcefile="acme/arcade.cpp" isbios="yes">
    <description>Acme Arcade BIOS</description>
    <year>1994</year>
    <manufacturer>Acme</manufacturer>
    <rom name="bios.u1" size="16" crc="b1050001" sha1="b105000000000000000000000000000000000001" region="bios" offset="0"/>
