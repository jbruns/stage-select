#!/bin/sh
# The chdman `real` beside it, except that what it extracts from Disc 2 of Saga gives back other bytes.
real="$(dirname "$0")/real"
case "$1:$3" in
createcd:*"Disc 2"*) touch disc2; exec "$real" "$@" ;;
extractcd:*) "$real" "$@" || exit $?; if [ -f disc2 ]; then printf XXXX | dd of=x/t1.bin conv=notrunc 2>/dev/null; fi ;;
*) exec "$real" "$@" ;;
esac
